# ============================================================================
# Lumen — Fotóarchívum és ügyfélgaléria | Vercel Deployment
# ============================================================================
# For Vercel: Set these environment variables in your Vercel Project Settings
# For local Docker: Copy to .env.local and fill in the values
# ============================================================================

# ============================================================================
# DATABASE
# ============================================================================
# Option 1: Supabase (recommended for Vercel + SFTP storage)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Option 2: Neon PostgreSQL (alternative)
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://user:password@host.neon.tech:5432/dbname
DATABASE_URL=postgresql://user:password@neon.tech:5432/lumen

# For Docker with local PostgreSQL: use postgres:5432
# DATABASE_URL=postgresql://lumen:password@postgres:5432/lumen

# ============================================================================
# STORAGE (SFTP Storage Box recommended for Vercel + Supabase)
# ============================================================================
# Options: sftp (Storage Box - recommended), blob (Vercel), mount (Docker volumes)
STORAGE_DRIVER=sftp

# SFTP Storage Box (recommended with Supabase):
STORAGE_HOST=uNNNNN.your-storagebox.de
STORAGE_PORT=23
STORAGE_USER=uNNNNN
STORAGE_PASSWORD=your_sftp_password

# For Vercel Blob (alternative):
# STORAGE_DRIVER=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# For Docker with mounted storage (local development):
# STORAGE_DRIVER=mount
# STORAGE_MOUNT_PATH=/mnt/storagebox

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here
SHARE_SESSION_SECRET=your_share_session_secret_here
ADMIN_API_KEY=your_admin_api_key_here

# Cron job secret for Vercel scheduled tasks (generate: openssl rand -base64 32)
CRON_SECRET=your_cron_secret_here

# ============================================================================
# OPTIONAL: CLIP AI INDEXING (for semantic search)
# ============================================================================
# Transformer model ID for text/image embeddings
# CLIP_MODEL=Xenova/clip-vit-base-patch32

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=production
