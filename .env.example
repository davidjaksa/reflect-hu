# -----------------------------------------------------------------------
# Lumen — Fotóarchívum és ügyfélgaléria  |  .env.example
#
# Másold .env.local (fejlesztés) vagy .env (Compose) névre,
# majd töltsd ki az összes kötelező értéket.
# -----------------------------------------------------------------------

# ---- Adatbázis (PostgreSQL + pgvector) ---------------------------------
# Compose-ban a "postgres" service neve használható hostként.
DATABASE_URL=postgresql://lumen:CSERE_JELSZO@postgres:5432/lumen

# ---- PostgreSQL Compose service jelszava (compose.yml olvas ebből) ----
POSTGRES_PASSWORD=CSERE_JELSZO

# ---- Hetzner Storage Box (SFTP) ----------------------------------------
STORAGE_HOST=uNNNNN.your-storagebox.de
STORAGE_PORT=23
STORAGE_USER=uNNNNN
STORAGE_PASSWORD=SFTP_JELSZO

# Opcionális: ha CIFS mountot használsz a SFTP helyett
# STORAGE_MOUNT_PATH=/mnt/storagebox
# STORAGE_DRIVER=mount

# ---- Admin API kulcs (Lightroom plugin és külső szerviz hozzáférés) ----
# Generálás: openssl rand -hex 32
ADMIN_API_KEY=CSERE_API_KULCS

# ---- Megosztott galériák session secret ---------------------------------
# Generálás: openssl rand -hex 32
SHARE_SESSION_SECRET=CSERE_SHARE_TITKOS_KULCS

# ---- Session titkosítás ------------------------------------------------
# Generálás: openssl rand -hex 32
SESSION_SECRET=CSERE_SESSION_TITKOS_KULCS

# ---- AI modell (CLIP, helyi CPU) ----------------------------------------
# Alapértelmezett modell ha nincs megadva:
# CLIP_MODEL=Xenova/clip-vit-base-patch32

# ---- Scratch könyvtár a worker számára ----------------------------------
# SCRATCH_DIR=/tmp/lumen-worker

# ---- Worker polling időköze milliszekundumban ---------------------------
# WORKER_POLL_INTERVAL_MS=5000
